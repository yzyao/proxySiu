# high-throughput: 36 concurrent checks, batches of 400, 5-15 minute cadence.
# idc-safe: 10 concurrent checks, batches of 100, 15-30 minute cadence.
PROXYSIU_PROFILE=idc-safe
# Required for both local dotnet run and Docker Compose. Generate a distinct long random value.
PROXYSIU_ACCESS_TOKEN=replace-with-a-long-random-token-at-least-24-characters
# Local Vite/HTTP development only. Compose overrides this to true behind HTTPS Nginx.
PROXYSIU_COOKIE_SECURE=false

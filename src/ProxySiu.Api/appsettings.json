{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning",
      "ProxySiu.Api.Services.ProxyChecker": "Information"
    }
  },
  "Urls": "http://127.0.0.1:5080",
  "AllowedHosts": "localhost;127.0.0.1",
  "CorsOrigins": [
    "http://localhost:5173",
    "http://127.0.0.1:5173"
  ],
  "ProxyPool": {
    "DataFile": "data/proxy-pool.json",
    "CheckUrl": "https://api.ipify.org?format=json",
    "RequestTimeoutSeconds": 6,
    "DownloadTimeoutSeconds": 20,
    "CheckConcurrency": 24,
    "SourceConcurrency": 3,
    "ScanIntervalMinutes": 120,
    "CheckIntervalMinutes": 10,
    "RecheckAliveMinutes": 30,
    "RecheckDeadMinutes": 180,
    "MaxChecksPerCycle": 300,
    "MaxCandidatesPerSource": 800,
    "MaxSourceBytes": 2000000,
    "MaxConsecutiveFailures": 3,
    "RemoveDeadAfterHours": 24,
    "ScanOnStartup": true,
    "AllowRemoteAccess": false,
    "AllowPrivateNetworks": false,
    "Sources": [
      {
        "Name": "Proxifly HTTP",
        "Url": "https://cdn.jsdelivr.net/gh/proxifly/free-proxy-list@main/proxies/protocols/http/data.txt",
        "Protocol": "Http",
        "Enabled": true
      },
      {
        "Name": "Proxifly SOCKS4",
        "Url": "https://cdn.jsdelivr.net/gh/proxifly/free-proxy-list@main/proxies/protocols/socks4/data.txt",
        "Protocol": "Socks4",
        "Enabled": true
      },
      {
        "Name": "Proxifly SOCKS5",
        "Url": "https://cdn.jsdelivr.net/gh/proxifly/free-proxy-list@main/proxies/protocols/socks5/data.txt",
        "Protocol": "Socks5",
        "Enabled": true
      },
      {
        "Name": "TheSpeedX HTTP",
        "Url": "https://raw.githubusercontent.com/TheSpeedX/PROXY-List/master/http.txt",
        "Protocol": "Http",
        "Enabled": true
      },
      {
        "Name": "TheSpeedX SOCKS4",
        "Url": "https://raw.githubusercontent.com/TheSpeedX/PROXY-List/master/socks4.txt",
        "Protocol": "Socks4",
        "Enabled": true
      },
      {
        "Name": "TheSpeedX SOCKS5",
        "Url": "https://raw.githubusercontent.com/TheSpeedX/PROXY-List/master/socks5.txt",
        "Protocol": "Socks5",
        "Enabled": true
      }
    ]
  }
}

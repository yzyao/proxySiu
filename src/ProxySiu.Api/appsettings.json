{
  "Logging": {
    "LogLevel": {
      "Default": "Warning",
      "Microsoft.AspNetCore": "Warning",
      "ProxySiu.Api.Services.ProxyChecker": "Warning",
      "ProxySiu.Api.Services.MaintenanceOperationQueue": "Information"
    },
    "Console": {
      "FormatterName": "simple",
      "FormatterOptions": {
        "TimestampFormat": "yyyy-MM-dd HH:mm:ss.fff zzz ",
        "SingleLine": true
      }
    }
  },
  "Urls": "http://127.0.0.1:5080",
  "AllowedHosts": "localhost;127.0.0.1",
  "CorsOrigins": [
    "http://localhost:5173",
    "http://127.0.0.1:5173"
  ],
  "ProxyAuth": {
    "Enabled": true,
    "AccessToken": "",
    "CookieSecure": true,
    "SessionHours": 12
  },
  "GeoIp": {
    "UseIpSb": true,
    "IpSbLookupIntervalSeconds": 2,
    "IpSbBaseUrl": "https://api.ip.sb"
  },
  "ProxyPool": {
    "DataFile": "data/proxy-pool.json",
    "CheckUrl": "https://api.ip.sb/geoip",
    "RequestTimeoutSeconds": 6,
    "DownloadTimeoutSeconds": 20,
    "CheckConcurrency": 36,
    "SourceConcurrency": 3,
    "ScanIntervalMinutes": 120,
    "CheckIntervalMinMinutes": 5,
    "CheckIntervalMaxMinutes": 15,
    "RecheckAliveMinutes": 30,
    "RecheckDeadMinutes": 60,
    "SecondDeadRetryMinutes": 360,
    "DeadQuarantineHours": 24,
    "ReaddQuarantineHours": 24,
    "AliveChecksPerCycle": 120,
    "PendingChecksPerCycle": 200,
    "DeadChecksPerCycle": 80,
    "MaxChecksPerCycle": 400,
    "MaxCandidatesPerSource": 800,
    "MaxPendingProxies": 600,
    "MaxSourceBytes": 2000000,
    "MaxConsecutiveFailures": 3,
    "RemoveDeadAfterHours": 24,
    "MaxPoolSize": 6000,
    "RemoveUnseenAfterHours": 12,
    "ScanOnStartup": true,
    "AllowRemoteAccess": false,
    "AllowInternalNetworkAccess": false,
    "AllowPrivateNetworks": false,
    "Profiles": {
      "high-throughput": {
        "CheckConcurrency": 36,
        "SourceConcurrency": 3,
        "ScanIntervalMinutes": 120,
        "CheckIntervalMinMinutes": 5,
        "CheckIntervalMaxMinutes": 15,
        "RecheckAliveMinutes": 30,
        "RecheckDeadMinutes": 60,
        "SecondDeadRetryMinutes": 360,
        "AliveChecksPerCycle": 120,
        "PendingChecksPerCycle": 200,
        "DeadChecksPerCycle": 80,
        "MaxChecksPerCycle": 400,
        "MaxPendingProxies": 1200
      },
      "idc-safe": {
        "CheckConcurrency": 10,
        "SourceConcurrency": 1,
        "ScanIntervalMinutes": 240,
        "CheckIntervalMinMinutes": 15,
        "CheckIntervalMaxMinutes": 30,
        "RecheckAliveMinutes": 60,
        "RecheckDeadMinutes": 180,
        "SecondDeadRetryMinutes": 720,
        "AliveChecksPerCycle": 50,
        "PendingChecksPerCycle": 40,
        "DeadChecksPerCycle": 10,
        "MaxChecksPerCycle": 100,
        "MaxPendingProxies": 300
      }
    },
    "Sources": [
      {
        "Name": "Proxifly HTTP",
        "Url": "https://cdn.jsdelivr.net/gh/proxifly/free-proxy-list@main/proxies/protocols/http/data.txt",
        "Protocol": "Http",
        "Enabled": true
      },
      {
        "Name": "Proxifly SOCKS4",
        "Url": "https://cdn.jsdelivr.net/gh/proxifly/free-proxy-list@main/proxies/protocols/socks4/data.txt",
        "Protocol": "Socks4",
        "Enabled": true
      },
      {
        "Name": "Proxifly SOCKS5",
